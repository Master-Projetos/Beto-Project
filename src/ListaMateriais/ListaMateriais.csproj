<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ListaMateriais</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>ListaMateriais</RootNamespace>
    <Version>2.1.0</Version>
    <Authors>Eduardo</Authors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- The default template goes inside the executable, so it works without the templates/ folder.
       templates/ is not versioned (client data); without it the build still works, with no default. -->
  <PropertyGroup>
    <DefaultTemplate>$(MSBuildThisFileDirectory)..\..\templates\lista_materiais.xlsx</DefaultTemplate>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DefaultTemplate)')">
    <EmbeddedResource Include="$(DefaultTemplate)" LogicalName="ListaMateriais.lista_materiais.xlsx" Link="templates\lista_materiais.xlsx" />
  </ItemGroup>

  <!-- Same for the TCR Word template used when the input is a PDF report. -->
  <PropertyGroup>
    <DefaultTcrTemplate>$(MSBuildThisFileDirectory)..\..\templates\tcr.docx</DefaultTcrTemplate>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DefaultTcrTemplate)')">
    <EmbeddedResource Include="$(DefaultTcrTemplate)" LogicalName="ListaMateriais.tcr.docx" Link="templates\tcr.docx" />
  </ItemGroup>

  <PropertyGroup>
    <DefaultTceTemplate>$(MSBuildThisFileDirectory)..\..\templates\tce.docx</DefaultTceTemplate>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DefaultTceTemplate)')">
    <EmbeddedResource Include="$(DefaultTceTemplate)" LogicalName="ListaMateriais.tce.docx" Link="templates\tce.docx" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ListaMateriais.Tests" />
  </ItemGroup>

  <!-- The window's title bar icon is loaded from here; the exe icon (ApplicationIcon) is not used by the form. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

</Project>
